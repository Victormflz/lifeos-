# ─── LifeOS Server — Environment Variables ───────────────────────────────────
# Copia este archivo como .env y rellena los valores reales.
# NUNCA commitees .env al repositorio.

# Puerto (Railway inyecta PORT automáticamente)
PORT=3001

# MongoDB Atlas connection string
# Genera una en: https://cloud.mongodb.com → Connect → Drivers
MONGODB_URI=mongodb+srv://<usuario>:<password>@cluster.mongodb.net/lifeos?retryWrites=true&w=majority

# JWT secret — usa una cadena aleatoria de 64 bytes en producción
# Genera: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=cambia_esto_por_una_cadena_larga_y_aleatoria_de_64_bytes

# Entorno
NODE_ENV=production

# Orígenes CORS permitidos en producción — separados por coma, sin barra final
# Ejemplo: https://lifeos.vercel.app,https://www.lifeos.vercel.app
ALLOWED_ORIGIN=https://tu-app.vercel.app

# Solo para el script create-admin — nunca dejar valores reales aquí
ADMIN_EMAIL=admin@tudominio.com
ADMIN_PASSWORD=
